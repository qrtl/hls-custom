<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='inter_company']" position="after">
                <setting
                    id="rep_title"
                    company_dependent="1"
                    string="Representative Title"
                    help="Title of the representative to display in printed documents."
                >
                    <field name="rep_title" placeholder="e.g., Managing Director" />
                </setting>

                <setting
                    id="rep_signature"
                    company_dependent="1"
                    string="Representative Signature"
                    help="Signature image of the representative to display in printed documents."
                >
                    <div class="content-group">
                        <div class="mt16">
                            <field
                                name="rep_signature"
                                widget="image"
                                options="{'size': [180, 180]}"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
