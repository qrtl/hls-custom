<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.secondary.unit.alternative</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_secondary_unit.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list//field[@name='secondary_uom_qty']"
                position="before"
            >
                <field
                    name="alt_secondary_qty"
                    groups="uom.group_uom"
                    optional="hide"
                />
                <field
                    name="alt_secondary_uom_id"
                    domain="product_id and ['|', ('product_id', '=', product_id),
                                '&amp;', ('product_tmpl_id.product_variant_ids', 'in', [product_id]),
                                         ('product_id', '=', False)] or [(0, '=', 1)]"
                    options="{'no_create': True}"
                    readonly="product_uom_readonly"
                    groups="uom.group_uom"
                    optional="hide"
                />
            </xpath>
        </field>
    </record>
</odoo>
