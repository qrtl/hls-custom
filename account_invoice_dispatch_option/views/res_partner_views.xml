<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.custom</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group>
                    <group>
                        <field name="use_company_invoice"/>
                        <field name="invoice_send_method"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='accounting_disabled']/div" position="after">
                <group>
                    <group>
                        <field name="use_company_invoice"/>
                        <field name="invoice_send_method"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
