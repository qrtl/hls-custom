<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_invoice_filter_inherit" model="ir.ui.view">
        <field name="name">account.invoice.filter.inherit</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <separator/>
                <filter string="Use Company Invoice" name="use_company_invoice" domain="[('use_company_invoice', '=', True)]"/>
                <filter string="Invoice Send Method - Post" name="invoice_send_method_post" domain="[('invoice_send_method', '=', 'post')]"/>
                <filter string="Invoice Send Method - Email" name="invoice_send_method_email" domain="[('invoice_send_method', '=', 'email')]"/>
                <filter string="Invoice Send Method - Do Not Send" name="invoice_send_method_do_not_send" domain="[('invoice_send_method', '=', 'do_not_send')]"/>
                <filter string="Invoice Send Method - Others" name="invoice_send_method_others" domain="[('invoice_send_method', '=', 'others')]"/>
            </xpath>
            <xpath expr="//filter[@name='duedate']" position="after">
                <separator/>
                <filter string="Use Company Invoice" name="group_by_use_company_invoice" context="{'group_by':'use_company_invoice'}"/>
                <filter string="Invoice Send Method" name="group_by_invoice_send_method" context="{'group_by':'invoice_send_method'}"/>
            </xpath>
        </field>
    </record>
    <record id="invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.invoice.form.inherit</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_invoice']/.." position="inside">
                <field name="use_company_invoice"/>
                <field name="invoice_send_method"/>
            </xpath>
        </field>
    </record>
    <record id="invoice_tree_with_onboarding_inherit" model="ir.ui.view">
        <field name="name">account.invoice.tree.inherit</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_tree_with_onboarding"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='number']" position="after">
                <field name="use_company_invoice"/>
                <field name="invoice_send_method"/>
            </xpath>
        </field>
    </record>
</odoo>
