<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_internal_search_inherit" model="ir.ui.view">
        <field name="name">stock.picking.search.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='backorder']" position="after">
                <separator/>
                <filter string="Use Company Invoice" name="use_company_invoice" domain="[('use_company_invoice', '=', True)]"/>
                <filter string="Invoice Send Method - Post" name="invoice_send_method_post" domain="[('invoice_send_method', '=', 'post')]"/>
                <filter string="Invoice Send Method - Email" name="invoice_send_method_email" domain="[('invoice_send_method', '=', 'email')]"/>
                <filter string="Invoice Send Method - Do Not Send" name="invoice_send_method_do_not_send" domain="[('invoice_send_method', '=', 'do_not_send')]"/>
                <filter string="Invoice Send Method - Others" name="invoice_send_method_others" domain="[('invoice_send_method', '=', 'others')]"/>
            </xpath>
            <xpath expr="//filter[@name='picking_type']" position="after">
                <separator/>
                <filter string="Use Company Invoice" name="group_by_use_company_invoice" context="{'group_by':'use_company_invoice'}"/>
                <filter string="Invoice Send Method" name="group_by_invoice_send_method" context="{'group_by':'invoice_send_method'}"/>
            </xpath>
        </field>
    </record>
</odoo>
