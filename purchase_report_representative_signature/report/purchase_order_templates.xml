<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_purchaseorder_document"
        inherit_id="purchase.report_purchaseorder_document"
    >
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div
                t-if="o.company_id.purchase_rep_title"
                style="width: 250px; margin-left: auto; margin-top: 30px; page-break-inside: avoid;"
            >
                <div style="text-align: center;">
                    <img
                        t-if="o.company_id.purchase_rep_signature"
                        t-att-src="image_data_uri(o.company_id.purchase_rep_signature)"
                        style="max-height: 100px;"
                        alt="Signature"
                    />
                    <hr style="border: none; border-bottom: 2px solid black;" />
                    <span t-field="o.company_id.purchase_rep_title" />
                </div>
            </div>
        </xpath>
    </template>
</odoo>
