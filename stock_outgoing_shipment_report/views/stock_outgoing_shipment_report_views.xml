<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_outgoing_shipment_report_search" model="ir.ui.view">
        <field name="name">stock.outgoing.shipment.report.search</field>
        <field name="model">stock.outgoing.shipment.report</field>
        <field name="arch" type="xml">
            <search string="Outgoing Moves">
                <field name="carrier_id" />
                <filter
                    name="createdtoday"
                    string="Created Today"
                    domain="[('create_date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))), ('create_date','&lt;=', datetime.datetime.combine(context_today(), datetime.time(23,59,59)))]"
                />
                <filter name="date_created" string="Created Date" date="date_created" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_carrier"
                        string="Carrier"
                        context="{'group_by':'carrier_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="view_stock_outgoing_shipment_report_tree" model="ir.ui.view">
        <field name="name">stock.outgoing.shipment.report.tree</field>
        <field name="model">stock.outgoing.shipment.report</field>
        <field name="arch" type="xml">
            <list string="Stock Outgoing Shipment Report" editable="top">
                <field name="dispatch_date" optional="show" />
                <field name="delivery_date" optional="show" />
                <field name="shipping_mode" optional="show" />
                <field name="carrier_name" optional="show" />
                <field name="partner_ref" optional="show" />
                <field name="partner_name" optional="show" />
                <field name="partner_zip" optional="show" />
                <field name="partner_address" optional="show" />
                <field name="partner_phone" optional="show" />
                <field name="product_code" optional="show" />
                <field name="product_name" optional="show" />
                <field name="case_qty" optional="show" />
                <field name="separate_qty" optional="show" />
                <field
                    name="expiry_date_edit"
                    widget="date"
                    string='Expiry Date'
                    optional="show"
                />
                <field name="expiry_date" column_invisible="1" />
                <field name="lot_num" optional="show" />
                <field name="lot_branch_num" optional="show" />
                <field name="delivery_division" optional="show" />
                <field name="customer_delivery_note" optional="show" />
                <field name="reference" optional="show" />
                <field name="memo" optional="show" />
            </list>
        </field>
    </record>
    <record id="action_stock_outgoing_shipment_report" model="ir.actions.act_window">
        <field name="name">Stock Outgoing Shipment Report</field>
        <field name="res_model">stock.outgoing.shipment.report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_createdtoday": 1}</field>
    </record>
    <menuitem
        action="action_stock_outgoing_shipment_report"
        id="stock_outgoing_shipment_report_menu"
        name="Stock Outgoing Shipment Report"
        parent="stock.menu_warehouse_report"
        sequence="3"
    />
</odoo>
